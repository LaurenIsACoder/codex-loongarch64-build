diff --git a/tools/rust_toolchain.py b/tools/rust_toolchain.py
index c46ca0e..bc65f86 100644
--- a/tools/rust_toolchain.py
+++ b/tools/rust_toolchain.py
@@ -9,6 +9,38 @@ import sys
 DIR = 'third_party/rust-toolchain'
 SENTINEL = f'{DIR}/.rusty_v8_version'
 
+# Chromium does not publish its bundled Rust toolchain for every host CPU.
+# Native downstream builders can point rusty_v8 at a host Rust sysroot instead.
+external_toolchain = os.environ.get('RUSTY_V8_RUST_TOOLCHAIN_ROOT')
+if external_toolchain:
+    external_toolchain = os.path.abspath(external_toolchain)
+    rustc = os.path.join(external_toolchain, 'bin', 'rustc')
+    rust_source = os.path.join(
+        external_toolchain, 'lib', 'rustlib', 'src', 'rust', 'library'
+    )
+    if not os.path.isfile(rustc) or not os.path.isdir(rust_source):
+        raise RuntimeError(
+            f'RUSTY_V8_RUST_TOOLCHAIN_ROOT must contain bin/rustc and '
+            f'lib/rustlib/src/rust/library: '
+            f'{external_toolchain}'
+        )
+    os.makedirs(DIR, exist_ok=True)
+    for component in ('bin', 'lib'):
+        source = os.path.join(external_toolchain, component)
+        destination = os.path.join(DIR, component)
+        if os.path.lexists(destination):
+            if os.path.islink(destination):
+                if os.path.realpath(destination) == os.path.realpath(source):
+                    continue
+                os.unlink(destination)
+            else:
+                raise RuntimeError(
+                    f'external Rust toolchain destination already exists: {destination}'
+                )
+        os.symlink(source, destination, target_is_directory=True)
+    print(f'using external Rust toolchain: {external_toolchain}')
+    sys.exit()
+
 host_os = platform.system().lower()
 if host_os == "darwin":
     host_os = "mac"
