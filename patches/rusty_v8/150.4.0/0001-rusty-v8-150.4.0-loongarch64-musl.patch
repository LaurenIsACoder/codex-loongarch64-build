diff --git a/tools/rust_toolchain.py b/tools/rust_toolchain.py
index baab10f..0347fcc 100644
--- a/tools/rust_toolchain.py
+++ b/tools/rust_toolchain.py
@@ -9,7 +9,20 @@ import sys
 DIR = 'third_party/rust-toolchain'
 SENTINEL = f'{DIR}/.rusty_v8_version'
 
+# Chromium does not publish its bundled Rust toolchain for every host CPU.
+# Native downstream builders can point rusty_v8 at a host Rust sysroot instead.
+external_toolchain = os.environ.get('RUSTY_V8_RUST_TOOLCHAIN_ROOT')
+if external_toolchain:
+    rustc = os.path.join(external_toolchain, 'bin', 'rustc')
+    if not os.path.isfile(rustc):
+        raise RuntimeError(
+            f'RUSTY_V8_RUST_TOOLCHAIN_ROOT has no bin/rustc: '
+            f'{external_toolchain}'
+        )
+    print(f'using external Rust toolchain: {external_toolchain}')
+    sys.exit()
+
 host_os = platform.system().lower()
 if host_os == "darwin":
     host_os = "mac"
 
